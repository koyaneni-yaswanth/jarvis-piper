<?xml version="1.0" encoding="utf-8"?>
<robot name="piper">
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.004736 0.000026 0.041452" rpy="0 0 0"/>
      <mass value="1.020"/>
      <inertia ixx="0.002674" ixy="-0.000001" ixz="-0.000174" iyy="0.002826" iyz="0.000000" izz="0.000896"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.08"/>
      </geometry>
      <material name="piper_dark">
        <color rgba="0.2 0.2 0.22 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.08"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.088" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.618" upper="2.618" effort="100.0" velocity="5.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

