# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C / C++ build artifacts
*.o
*.so
*.dylib
*.a

# ROS 2 Build directories
build/
install/
log/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Virtual environments
venv/
.venv/
env/
.env/

# Data & large media files
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep
dataset/exports/*
!dataset/exports/.gitkeep
dataset/test_demo/
dataset/test_exported/
dataset/public/
workspace_data_collection*/
*.bag
*.db3
*.mcap
*.mp4
*.avi
*.mkv
*.h5
*.hdf5
*.npz

# Checkpoints & model weights
models/checkpoints/*
!models/checkpoints/.gitkeep
models/exported/*
!models/exported/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Logs & experiments
experiments/logs/
experiments/results/
logs/
data/
*.log
.pytest_cache/
.coverage
htmlcov/

# Local configuration & calibration (never commit machine-specific paths or calibration)
configs/local.yaml
configs/calibration.yaml
calibration/
*.calib
*.calibration
config.json

# Secrets, tokens, and private environment files
.env
.env.*
*.key
*.pem
*.token
*secret*
*credentials*

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
push_err.txt
push_out.txt
